# Copy to .env for local reference, or set these directly in your shell /
# deploy platform. Spring Boot reads OS environment variables directly, so
# a .env file isn't loaded automatically unless you export it yourself, e.g.:
#   export $(grep -v '^#' .env | xargs)

# Required for the "describe your situation" free-text endpoint.
# Get one at https://console.anthropic.com/settings/keys — never commit it.
ANTHROPIC_API_KEY=

# Optional. Only required if APP_ACCESS_WHITELIST_ENABLED=true. Paste the
# full contents of a Firebase service-account JSON key as a single line.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional email whitelist gate, off by default. See README "Legal & privacy".
APP_ACCESS_WHITELIST_ENABLED=false

# Comma-separated list of frontend origins allowed to call this API.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
